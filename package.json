{
  "name": "mukai-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Mukai backend HTTP API as tools.",
  "type": "module",
  "private": true,
  "bin": {
    "mukai-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
