{
  "name": "mukai-mcp",
  "version": "1.0.0",
  "description": "MCP server for Mukai: control a Mukai installation from Claude, ChatGPT and other MCP clients, with OAuth sign-in, human-in-the-loop approvals and permission rules.",
  "author": "Sindiso Matikiti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matikitisindiso-sys/mukai-MCP.git"
  },
  "homepage": "https://github.com/matikitisindiso-sys/mukai-MCP#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mukai",
    "claude",
    "chatgpt",
    "ai-agents",
    "oauth"
  ],
  "type": "module",
  "private": true,
  "bin": {
    "mukai-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/rules.test.mjs test/proxy-ip.test.mjs test/health.test.mjs test/oauth-browser.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
