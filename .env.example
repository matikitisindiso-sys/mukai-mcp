# Base URL of the Mukai backend API.
#  - `mukai serve` / browser mode (incl. a public tunnel/domain): https://your-domain.example/api
#  - Desktop / `npm run dev:server` on the same machine:          http://127.0.0.1:47831
MUKAI_API_URL=http://127.0.0.1:47831

# Mukai backend API token (Settings -> API in Mukai, or the `api.token` file in the Mukai data dir).
MUKAI_API_TOKEN=

# Bearer token clients must send to this MCP server over HTTP. REQUIRED for HTTP mode, 32+ chars.
# Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HTTP listener
PORT=3333
HOST=0.0.0.0
# Optional: comma-separated Host header allowlist (DNS-rebinding protection), e.g. mcp.example.com
# MCP_ALLOWED_HOSTS=

# Default seconds a chat tool waits for a bot reply before returning (the run keeps going
# server-side; re-call with the same requestId to reattach). Keep below your MCP client's
# tool-call timeout (often 60s).
# MUKAI_CHAT_WAIT_SECONDS=55

# ---- Security policy (safe defaults; see docs/SECURITY.md) ----
# MCP_APPROVAL_MODE=ask-for-approval  # ask-for-approval | full-access (default; per-workspace via tools)
# MCP_STATE_FILE=data/mcp-state.json  # per-workspace MCP modes (keep on a persistent volume)
# MCP_SENSITIVE_TOOLS=confirm      # confirm | disable | allow
# MCP_TOOL_PROFILE=standard        # read-only | standard | full
# MCP_ENABLE_RAW_API=false
# MCP_DISABLED_TOOLS=
# MCP_ALLOW_QUERY_TOKEN=false
# MCP_TRUST_PROXY=false
# MCP_AUTH_MAX_FAILURES=10
# MCP_CONFIRM_TIMEOUT_SECONDS=600
