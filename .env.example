# Base URL of the Mukai backend API.
#  - `mukai serve` / browser mode (incl. a public tunnel/domain): https://your-domain.example/api
#  - Desktop / `npm run dev:server` on the same machine:          http://127.0.0.1:47831
MUKAI_API_URL=http://127.0.0.1:47831

# Mukai backend API token (Settings -> API in Mukai, or the `api.token` file in the Mukai data dir).
MUKAI_API_TOKEN=

# Bearer token clients must send to this MCP server over HTTP. REQUIRED for HTTP mode.
MCP_AUTH_TOKEN=

# HTTP listener
PORT=3333
HOST=0.0.0.0
# Optional: comma-separated Host header allowlist (DNS-rebinding protection), e.g. mcp.example.com
# MCP_ALLOWED_HOSTS=

# Default seconds a chat tool waits for a bot reply before returning (the run keeps going
# server-side; re-call with the same requestId to reattach). Keep below your MCP client's
# tool-call timeout (often 60s).
# MUKAI_CHAT_WAIT_SECONDS=55
